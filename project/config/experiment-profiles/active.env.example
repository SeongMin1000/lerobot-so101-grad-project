# Copy to active.env, then verify every value against the current checkpoint,
# devices, and network. This file must never contain tokens, passwords, or keys.

export PROFILE_UPDATED_AT="YYYY-MM-DD"
export PROFILE_STATUS="draft_verify_before_use"

export LEROBOT_ROOT="${LEROBOT_ROOT:-$HOME/lerobot}"
export HF_USER="${HF_USER:-eslab1234}"
export LEROBOT_RUNTIME_CONFIG="${LEROBOT_RUNTIME_CONFIG:-$LEROBOT_ROOT/project/config/runtime.json}"
export LEROBOT_DETECTOR_CALIB="${LEROBOT_DETECTOR_CALIB:-$LEROBOT_ROOT/project/config/detector.json}"
export RUNTIME_CONFIG="$LEROBOT_RUNTIME_CONFIG"

export ROBOT_PORT="${ROBOT_PORT:-/dev/so101_follower}"
export TELEOP_PORT="${TELEOP_PORT:-/dev/so101_leader}"
export TOP_CAM="${TOP_CAM:-/dev/cam_top}"
export WRIST_CAM="${WRIST_CAM:-/dev/cam_wrist}"
export BELLY_CAM="${BELLY_CAM:-/dev/cam_belly}"

export WIDTH="${WIDTH:-640}"
export HEIGHT="${HEIGHT:-480}"
export FPS="${FPS:-30}"
export CAMERA_FOURCC="${CAMERA_FOURCC:-MJPG}"
export BELLY_ROTATION="${BELLY_ROTATION:-180}"

export POLICY_SERVER_HOST="${POLICY_SERVER_HOST:-0.0.0.0}"
export POLICY_SERVER_PORT="${POLICY_SERVER_PORT:-8080}"
export SERVER_ADDRESS="${SERVER_ADDRESS:-GPU_TAILSCALE_IP:8080}"
export INFERENCE_LATENCY="${INFERENCE_LATENCY:-0.033}"
export OBS_QUEUE_TIMEOUT="${OBS_QUEUE_TIMEOUT:-1.0}"

export ACTIVE_DATASET="${ACTIVE_DATASET:-eslab1234/REPLACE_DATASET}"
export ACTIVE_MODEL="${ACTIVE_MODEL:-eslab1234/REPLACE_MODEL}"
export MODEL_PATH="${MODEL_PATH:-$ACTIVE_MODEL}"
export TASK="${TASK:-REPLACE_WITH_EXACT_RECORDING_TASK_TEXT}"
export CAMERA_KEY_MODE="${CAMERA_KEY_MODE:-policy}"

export ACTIONS_PER_CHUNK="${ACTIONS_PER_CHUNK:-20}"
export CHUNK_SIZE_THRESHOLD="${CHUNK_SIZE_THRESHOLD:-0.6}"
export AGGREGATE_FN_NAME="${AGGREGATE_FN_NAME:-latest_only}"
export MAX_RELATIVE_TARGET="${MAX_RELATIVE_TARGET:-1.0}"
export MAX_TRACKING_ERROR="${MAX_TRACKING_ERROR:-5.0}"
export TRACKING_ERROR_GRACE_STEPS="${TRACKING_ERROR_GRACE_STEPS:-2}"
export INFERENCE_SECONDS="${INFERENCE_SECONDS:-60}"
export DISABLE_TORQUE_ON_DISCONNECT="${DISABLE_TORQUE_ON_DISCONNECT:-false}"
export SKIP_CONFIRM="${SKIP_CONFIRM:-false}"

export DEBUG_OBSERVATION_DIR="${DEBUG_OBSERVATION_DIR:-$LEROBOT_ROOT/var/debug/client_camera_inputs}"
export DEBUG_OBSERVATION_LIMIT="${DEBUG_OBSERVATION_LIMIT:-1}"
export DEBUG_MOTOR_TRACE_DIR="${DEBUG_MOTOR_TRACE_DIR:-$LEROBOT_ROOT/var/debug/motor_traces}"
export DEBUG_MOTOR_TRACE_LIMIT="${DEBUG_MOTOR_TRACE_LIMIT:-300}"

# Training values are inputs for command generation, not authorization to run.
export TRAIN_PROFILE_STATUS="draft_verify_with_lerobot_train_help"
export BASE_MODEL="${BASE_MODEL:-lerobot/smolvla_base}"
export TRAIN_DATASET="${TRAIN_DATASET:-eslab1234/REPLACE_TRAIN_DATASET}"
export TRAIN_DATASET_ROOT="${TRAIN_DATASET_ROOT:-$HOME/.cache/huggingface/lerobot/$TRAIN_DATASET}"
export RUN_NAME="${RUN_NAME:-REPLACE_RUN_NAME}"
export TRAIN_OUTPUT_DIR="${TRAIN_OUTPUT_DIR:-$LEROBOT_ROOT/outputs/train/$RUN_NAME}"
export TRAIN_STEPS="${TRAIN_STEPS:-20000}"
export TRAIN_BATCH_SIZE="${TRAIN_BATCH_SIZE:-8}"
export TRAIN_LEARNING_RATE="${TRAIN_LEARNING_RATE:-}"
export TRAIN_WARMUP_STEPS="${TRAIN_WARMUP_STEPS:-1000}"
export TRAIN_NUM_WORKERS="${TRAIN_NUM_WORKERS:-4}"
export TRAIN_SAVE_FREQ="${TRAIN_SAVE_FREQ:-5000}"
export TRAIN_LOG_FREQ="${TRAIN_LOG_FREQ:-100}"
export TRAIN_USE_PEFT="${TRAIN_USE_PEFT:-true}"
export TRAIN_PEFT_R="${TRAIN_PEFT_R:-64}"
export TRAIN_PEFT_ALPHA="${TRAIN_PEFT_ALPHA:-64}"
export TRAIN_FREEZE_VISION_ENCODER="${TRAIN_FREEZE_VISION_ENCODER:-true}"
export TRAIN_EXPERT_ONLY="${TRAIN_EXPERT_ONLY:-true}"
export TRAIN_STATE_PROJ="${TRAIN_STATE_PROJ:-true}"
export TRAIN_USE_AMP="${TRAIN_USE_AMP:-false}"
export TRAIN_CUDA_VISIBLE_DEVICES="${TRAIN_CUDA_VISIBLE_DEVICES:-0}"
export WANDB_PROJECT="${WANDB_PROJECT:-lerobot}"
